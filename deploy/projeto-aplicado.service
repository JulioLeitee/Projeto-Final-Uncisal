# /etc/systemd/system/projeto-aplicado.service
#
# A02:2025 — Security Misconfiguration. O serviço roda como usuário sem
# privilégio, escuta apenas no loopback e é confinado por sandbox do systemd:
# mesmo que a aplicação seja comprometida, o que o atacante alcança é mínimo.

[Unit]
Description=Projeto Aplicado - aplicacao web segura (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=appuser
Group=appuser
WorkingDirectory=/opt/projeto-aplicado/app

# Segredos vêm de um arquivo 0600 fora do repositório, nunca do código.
EnvironmentFile=/etc/projeto-aplicado/app.env

ExecStart=/opt/projeto-aplicado/.venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile - \
    --forwarded-allow-ips 127.0.0.1 \
    --timeout 30 \
    app:app

ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

# --- Sandbox ---------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

# A aplicação não escreve em disco: todo o filesystem fica somente leitura.
ReadOnlyPaths=/opt/projeto-aplicado /etc/projeto-aplicado

[Install]
WantedBy=multi-user.target
