# MODELO de variáveis de ambiente. O arquivo real (app.env) é gerado NO
# SERVIDOR por deploy/setup-server.sh, fica em /etc/projeto-aplicado/ com modo
# 0640 e JAMAIS é versionado (ver .gitignore).

# Chave de assinatura do cookie de sessão. Mínimo 32 caracteres.
# Gere com: openssl rand -base64 48
# A aplicação se RECUSA a subir sem esta variável — não há valor padrão.
APP_SECRET_KEY=

# Caminho do JSON com os hashes Argon2id dos usuários.
APP_USERS_FILE=/etc/projeto-aplicado/users.json

# Expiração da sessão por inatividade, em minutos.
APP_SESSION_MINUTES=20
