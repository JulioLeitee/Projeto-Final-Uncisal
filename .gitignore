# =============================================================================
# Eixo 2 — Prevenção de vazamento de dados.
# O escopo prevê PENALIDADE IMEDIATA por credencial real commitada.
# Regra prática: se o arquivo contém um segredo, o nome dele entra aqui ANTES
# do primeiro `git add`.
# =============================================================================

# --- Segredos e configuração de ambiente ------------------------------------
.env
.env.*
!.env.example
app.env
*.env.local
secrets/
credentials*
config.local.*

# --- Credenciais da aplicação (hashes de senha dos usuários) ----------------
users.json
!users.json.example

# --- Chaves privadas e certificados -----------------------------------------
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
*.ppk
known_hosts
.ssh/

# --- Credenciais de nuvem ----------------------------------------------------
.aws/
.oci/
oci_api_key*.pem
.azure/
gcloud/
*service-account*.json
*credentials*.json
terraform.tfstate
terraform.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/

# --- Banco de dados local ----------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sql
*.dump

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# --- IDE e sistema operacional ----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Antigravity / assistentes de IA ----------------------------------------
# Diretórios de contexto local podem conter caminhos, tokens e trechos de
# configuração da máquina de desenvolvimento.
.antigravity/
.gemini/
.cursor/
.aider*
.claude/

# --- Logs e temporários ------------------------------------------------------
*.log
logs/
tmp/
*.bak
*.orig
